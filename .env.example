# Copia este archivo como .env.local y completa los valores. NUNCA lo subas a git.

# Contraseña para entrar a la app (obligatoria)
APP_PASSWORD=

# IA (insights / chat)
GEMINI_API_KEY=

# --- Conectar con un clic: Meta ---
META_APP_ID=
META_APP_SECRET=
# ID de la "configuración" de Facebook Login for Business (déjalo vacío si usas el login clásico)
META_LOGIN_CONFIG_ID=
# META_API_VERSION=v23.0

# --- Conectar con un clic: Google (Ads + GA4) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_API_VERSION=v21

# Opcional: si usas un dominio/túnel, la URL base pública (sin /api)
# OAUTH_REDIRECT_BASE=https://mi-dominio.com

# Minutos que se reutilizan los datos de cada plataforma antes de volver a consultarla (por defecto 10).
# Súbelo si Meta muestra "too many calls to this ad-account".
SYNC_CACHE_MINUTES=10
